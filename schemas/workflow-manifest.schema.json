{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bojii-custom-harness/agent-system-default-workflows/schemas/workflow-manifest.schema.json",
  "title": "Agent System Default Workflow source inventory",
  "type": "object",
  "required": ["schemaVersion", "sourceCommit", "workflowGeneratorSourceVersion", "systemSkillsSourceVersion", "workflows"],
  "properties": {
    "schemaVersion": { "const": "agent-system.default-workflows-manifest.v1" },
    "sourceCommit": { "$ref": "#/$defs/commit" },
    "workflowGeneratorSourceVersion": { "$ref": "#/$defs/semver" },
    "systemSkillsSourceVersion": { "$ref": "#/$defs/semver" },
    "workflows": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "required": ["id", "uuid", "version", "sourceVersion", "file", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,79}$" },
          "uuid": { "type": "string", "format": "uuid" },
          "version": { "$ref": "#/$defs/semver" },
          "sourceVersion": { "$ref": "#/$defs/semver" },
          "file": { "type": "string", "pattern": "^workflows/[a-z0-9][a-z0-9-]{0,79}\\.json$" },
          "sha256": { "$ref": "#/$defs/sha256" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9A-Za-z-]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" }
  }
}
